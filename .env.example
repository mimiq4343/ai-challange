# Любой OpenAI-совместимый провайдер. Скопируйте файл в .env.local и заполните.
# Примеры base URL:
#   DeepSeek:   https://api.deepseek.com/v1
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Второй провайдер, нужен только странице /day-5: там один и тот же запрос
# уходит на модели DeepSeek и на модель Groq одновременно.
#   GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BASE_URL=
GROQ_API_KEY=
