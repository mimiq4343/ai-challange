# Любой OpenAI-совместимый провайдер. Скопируйте файл в .env.local и заполните.
# Примеры base URL:
#   DeepSeek:   https://api.deepseek.com/v1
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Второй провайдер, нужен только странице /day-5: там один и тот же запрос
# уходит на модели DeepSeek и на модель Groq одновременно.
#   GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BASE_URL=
GROQ_API_KEY=

# Только для реального overflow-теста на странице /day-8.
OPENROUTER_API_KEY=

# Day 18: общий серверный секрет Next.js и защищённого MCP endpoint.
# Случайная строка из 32–256 символов A–Z, a–z, 0–9, _ или -.
# Не передавайте токен в браузер, URL или аргументы команд.
MCP_SCHEDULER_TOKEN=

# Day 19: отдельный серверный секрет MCP-пайплайна, формат как у токена Day 18.
MCP_PIPELINE_TOKEN=
